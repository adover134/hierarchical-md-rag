# 복사해서 `.env`로 만들고 값을 채운다. `.env`는 git에 올리지 않는다.

# 답변용 LLM (로컬 Ollama 예시. Groq이면 https://api.groq.com/openai/v1)
HWP_RAG_LLM_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
REASONING_MODEL=gpt-oss:20b
QUERY_INTENT_MODEL=gpt-oss:20b

# API 서버 접속 키 (쉼표로 여러 개, 비우면 인증 없이 열림)
RAG_API_KEYS=

# Gradio 화면 접속 아이디와 비밀번호 (둘 다 채우거나 둘 다 비운다)
GRADIO_APP_USERNAME=
GRADIO_APP_PASSWORD=

# Langfuse (선택). 두 키를 채우면 질문별 시간과 토큰 수를 기록한다. 질문, 근거, 답변 원문은 보내지 않는다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 가입한 지역 주소: https://cloud.langfuse.com(EU), https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
